.{
    .name = .pjsx,
    .version = "0.1.0",
    .fingerprint = 0x55f7e24dabd4a852, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Build-time only: supplies the `amalgamate` and `docs` steps. Ships
        // nothing into the library itself, so consumers of pjsx never see it.
        .publr_tools = .{ .path = "../lib/tools" },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "build",
        "src",
        "tests",
        "scripts",
        "package.json",
        "package-lock.json",
        "README.md",
    },
}
